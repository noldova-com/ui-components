{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "docs": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "prefix": "nol",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../../_build/docs",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "../noldova.ui.components.angular/src/styles/theme.css",
              "../noldova.ui.components.angular/src/styles/kit.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "docs:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "../noldova.ui.components.angular/vitest.config.mts",
            "browsers": [
              "chromiumHeadless"
            ],
            "browserViewport": "1280x800",
            "include": [
              "tests/**/*.spec.ts"
            ],
            "providersFile": "tests/test-providers.ts",
            "setupFiles": [
              "tests/kit-stylesheet.setup.ts"
            ],
            "watch": false,
            "coverage": true,
            "coverageInclude": [
              "src/**/*.ts"
            ],
            "coverageReporters": [
              "text",
              "json-summary",
              "json"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            },
            "coverageExclude": [
              "src/app/enums/**",
              "src/main.ts",
              "src/main.server.ts",
              "src/app/app.config.server.ts",
              "src/app/app.routes.server.ts"
            ]
          }
        }
      }
    }
  }
}
