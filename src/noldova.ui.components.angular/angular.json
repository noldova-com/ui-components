{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "components": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "prefix": "nol",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "vitest.config.mts",
            "browsers": [
              "chromiumHeadless"
            ],
            "browserViewport": "1280x800",
            "include": [
              "tests/**/*.spec.ts"
            ],
            "providersFile": "tests/test-providers.ts",
            "setupFiles": [
              "tests/shared-page.setup.ts",
              "tests/browser-matchers.setup.ts",
              "tests/kit-stylesheet.setup.ts"
            ],
            "watch": false,
            "coverage": true,
            "coverageInclude": [
              "src/**/*.ts"
            ],
            "coverageReporters": [
              "text",
              "json-summary",
              "json"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            },
            "coverageExclude": [
              "src/app/enums/**"
            ]
          }
        },
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../../_build/angular/build",
            "tsConfig": "tsconfig.spec.json",
            "styles": [
              "src/styles/kit.css"
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "bundle-typography": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "prefix": "nol",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../../_build/kit-bundles/bundle-typography",
            "browser": "tests/fixtures/kit-bundles/typography-app.fixture.ts",
            "index": false,
            "tsConfig": "tests/fixtures/kit-bundles/tsconfig.typography.json",
            "optimization": true,
            "outputHashing": "none",
            "statsJson": true
          }
        }
      }
    },
