{
  "name": "@noldova/ui-components",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "build": "node src/noldova.ui.components.angular/scripts/build-workspaces.ts",
    "build:components": "npm run build --workspaces --if-present --",
    "build:docs": "npm run docs:build --workspaces --if-present --",
    "newest-context": "node src/noldova.ui.components.angular/scripts/newest-context.ts",
    "test": "npm run test --workspaces --if-present --",
    "test:docs": "npm run docs:test --workspaces --if-present --"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
